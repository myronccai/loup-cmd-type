@mode(host.dual)

from appinfo import (APP_NAME, APP_VERSION);

# The text of `type /?`, as Windows prints it.
pub func usage(): string {
    let lines = [
        "Displays the contents of a text file or files.",
        "",
        "TYPE [drive:][path]filename",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}

@mode(host.dual)

# Exit statuses of the whole command line. These tests print the program's
# normal output.

from debug.assert import (expectEq);
from io.fs import (createDir, writeText, removeDir, isDir);
from appinfo import (EXIT_OK, EXIT_FAILURE);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["/?"]), EXIT_OK, "/?");
}

func test_no_operand_fails(): void {
    let none: list[string] = [];
    expectEq(run(none), EXIT_FAILURE, "syntax error");
}

func test_type_file(): void {
    let root = "build/tmp/app_type";
    if (isDir(root)) {
        removeDir(root);
    }
    createDir(root);
    writeText(root + "/t.txt", "tests pass\n");
    expectEq(run([root + "\\t.txt"]), EXIT_OK, "existing file");
    expectEq(run([root + "/t.txt", root + "/missing.txt"]), EXIT_FAILURE, "one missing");
    removeDir(root);
}

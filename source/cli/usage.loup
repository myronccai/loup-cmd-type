@mode(host.dual)

# Help and version text of type: what `type /?` prints, worded as Windows
# prints it, and the series' `--version` line.
#
# Runtime: host.dual. Compiled into the native binary build/type by
# `make build`; `loup run source/main.loup` interprets the same code.

from appinfo import (APP_NAME, APP_VERSION);

# The text of `type /?`, as Windows prints it.
pub func usage(): string {
    let lines = [
        "Displays the contents of a text file or files.",
        "",
        "TYPE [drive:][path]filename",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}

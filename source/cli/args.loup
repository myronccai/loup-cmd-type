@mode(host.dual)

# Command-line parsing for type. type has no switches of its own: `/?`
# asks for help, and every other argument (including `/X` and `-X`) names a
# file, following the Windows switch convention in win/switches.loup.

from win.switches import (SwitchSpec, parse_switches, switch_error_message);

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub operands: list[string];
}

# The switches type declares: none.
pub func type_switches(): list[SwitchSpec] {
    let none: list[SwitchSpec] = [];
    return none;
}

pub func parse_args(argv: list[string]): Result[Options, string] {
    return match parse_switches(argv, type_switches()) {
        Ok(parsed) => Ok(Options(
            help = parsed.help,
            version = parsed.version,
            operands = parsed.operands,
        )),
        Err(e) => Err(switch_error_message(e)),
    };
}

@mode(host.dual)

# Unit tests for type's argument parsing (cli/args.loup): type declares no
# switches, so every argument other than a help or version request and `--` is
# a file name.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with `loup-bootstrap test --no-parallel` (Stage0, source/ on LOUPPATH), one
# test per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, type_switches);

func test_no_arguments(): void {
    let none: list[string] = [];
    let opts = parse_args(none).unwrap();
    expectEq(opts.operands.len(), 0, "no operands");
    expect(!opts.help and !opts.version, "no help or version");
}

func test_type_has_no_switches(): void {
    expectEq(type_switches().len(), 0, "none declared");
}

func test_every_argument_is_a_file(): void {
    let opts = parse_args(["a.txt", "/p", "-x", "sub\\b.txt", "*.log"]).unwrap();
    expectEq(opts.operands.join(","), "a.txt,/p,-x,sub\\b.txt,*.log", "operands in order");
}

func test_help(): void {
    expect(parse_args(["/?"]).unwrap().help, "/?");
    expect(parse_args(["a.txt", "-?"]).unwrap().help, "-? with a file");
    expect(parse_args(["--help"]).unwrap().help, "--help");
}

func test_version(): void {
    expect(parse_args(["--version"]).unwrap().version, "--version");
    expect(!parse_args(["a", "--version"]).unwrap().version, "--version with a file");
}

func test_double_dash(): void {
    let opts = parse_args(["--", "/?"]).unwrap();
    expect(!opts.help, "/? after -- is a file");
    expectEq(opts.operands[0], "/?", "operand");
}

@mode(host.dual)

# Command-line parsing for type. type has no switches of its own: `/?` asks
# for help, and every other argument (including `/X` and `-X`) names a file,
# following the Windows switch convention in win/switches.loup. Errors are
# UsageErrors (win/switches.loup).
#
# Runtime: host.dual. Compiled into the native binary build/type by
# `make build`; `loup run source/main.loup` interprets the same code.

from win.switches import (SwitchSpec, UsageError, parse_switches);

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub operands: list[string];
}

# The switches type declares: none.
pub func type_switches(): list[SwitchSpec] {
    let none: list[SwitchSpec] = [];
    return none;
}

# A usage error comes back as a UsageError: `?` converts the parser's
# SwitchError with UsageError.from() (win/switches.loup). type declares no
# switch that takes a value, so in practice parsing always succeeds.
pub func parse_args(argv: list[string]): Result[Options, UsageError] {
    let parsed = parse_switches(argv, type_switches())?;
    return Ok(Options(
        help = parsed.help,
        version = parsed.version,
        operands = parsed.operands,
    ));
}
